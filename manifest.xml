<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>7f2a9c40-3b1e-4d8a-9c6f-0a1b2c3d4e5f</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>SIGNIDENT</ProviderName>
  <DefaultLocale>de-DE</DefaultLocale>
  <DisplayName DefaultValue="SIGNIDENT"/>
  <Description DefaultValue="Setzt beim Verfassen automatisch die zentral verwaltete E-Mail-Signatur. Tenant-native: SIGNIDENT verwaltet nur Vorlagen und Verzeichnisdaten und routet niemals E-Mails."/>
  <IconUrl DefaultValue="https://uvaree.github.io/signova-spike/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://uvaree.github.io/signova-spike/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://uvaree.github.io/signova-spike/"/>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://uvaree.github.io/signova-spike/taskpane.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="msgComposeGroup">
                  <Label resid="GroupLabel"/>
                  <Control xsi:type="Button" id="msgComposeButton">
                    <Label resid="TaskpaneButton.Label"/>
                    <Supertip>
                      <Title resid="TaskpaneButton.Label"/>
                      <Description resid="TaskpaneButton.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16x16"/>
                      <bt:Image size="32" resid="Icon.32x32"/>
                      <bt:Image size="80" resid="Icon.80x80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="Taskpane.Url"/>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>

          <!--
            Vorbereitet fuer den spaeteren iOS-/Android-Test.

            Auf Mobilgeraeten gibt es KEIN OnNewMessageCompose: Outlook Mobile
            unterstuetzt bislang keine Launch-Events. Es bleibt also beim
            Knopf in der Taskpane - die Automatik greift nur am Desktop und im
            Web. Genau deshalb steht hier nur die MessageComposeCommandSurface.

            NOCH NICHT NUTZBAR: Die globalen <Requirements> oben verlangen
            Mailbox 1.10. Outlook Mobile erfuellt das nicht, das Add-in laesst
            sich dort also gar nicht erst installieren - dieser Block ist
            derzeit reine Vorbereitung.

            Fuer einen echten iOS-Test muesste die MinVersion auf 1.5 gesenkt
            und im Code geprueft werden, ob setSignatureAsync (1.10) vorhanden
            ist, bevor es aufgerufen wird. Das ist bewusst NICHT Teil dieses
            Pakets, weil es das Verhalten am Desktop veraendern wuerde.
          -->
          <MobileFormFactor>
            <ExtensionPoint xsi:type="MobileMessageComposeCommandSurface">
              <Group id="mobileMsgComposeGroup">
                <Label resid="GroupLabel"/>
                <Control xsi:type="MobileButton" id="mobileMsgComposeButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Icon>
                    <bt:Image size="25" scale="1" resid="Icon.16x16"/>
                    <bt:Image size="32" scale="1" resid="Icon.32x32"/>
                    <bt:Image size="48" scale="1" resid="Icon.80x80"/>
                    <bt:Image size="25" scale="2" resid="Icon.16x16"/>
                    <bt:Image size="32" scale="2" resid="Icon.32x32"/>
                    <bt:Image size="48" scale="2" resid="Icon.80x80"/>
                    <bt:Image size="25" scale="3" resid="Icon.16x16"/>
                    <bt:Image size="32" scale="3" resid="Icon.32x32"/>
                    <bt:Image size="48" scale="3" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://uvaree.github.io/signova-spike/assets/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://uvaree.github.io/signova-spike/assets/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://uvaree.github.io/signova-spike/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://uvaree.github.io/signova-spike/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://uvaree.github.io/signova-spike/launchevent.js"/>
          <bt:Url id="Commands.Url" DefaultValue="https://uvaree.github.io/signova-spike/commands.html"/>
          <bt:Url id="Taskpane.Url" DefaultValue="https://uvaree.github.io/signova-spike/taskpane.html"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="SIGNIDENT"/>
          <bt:String id="TaskpaneButton.Label" DefaultValue="SIGNIDENT Info"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Zeigt Informationen zu SIGNIDENT."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
